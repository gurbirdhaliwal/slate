# Copy to .env (chmod 600, never commit). Referenced by docker-compose.yml.

# --- Postgres (single instance: relational + vector + time-series + job queue) ---
POSTGRES_USER=slate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slate

# --- LLM judges (workers) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                          # embeddings only (Phase 2 clustering)

# --- Auth ---
JWT_PRIVATE_KEY_PATH=/secrets/jwt-rs256.pem    # dashboard session signing (RS256)
API_KEY_PEPPER=change-me                       # server-side pepper for hashed customer API keys

# --- MinIO (raw step payload storage, S3-compatible) ---
MINIO_ROOT_USER=slate-minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=slate-payloads

# --- Config ---
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=info
WORKER_CONCURRENCY=10
MAX_ANALYSIS_JOBS_PER_RUN=500
ANTHROPIC_MAX_CALLS_PER_10S=50                 # worker-side token bucket
SUCCESS_SAMPLE_RATE=0.05                       # fraction of successful runs analyzed
